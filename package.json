{
  "name": "@area44/astro-shadcn-ui-template",
  "version": "23.12.26",
  "description": "An Astro template for building apps.",
  "author": {
    "name": "AREA44"
  },
  "license": "MIT",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "format": "prettier -w . --cache",
    "format:check": "prettier --check package.json astro.config.ts tailwind.config.ts src/styles/globals.css .github/workflows/autofix.yml",
    "preview": "astro preview",
    "start": "astro dev",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run format:check && pnpm run typecheck"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@contentful/rich-text-html-renderer": "^17.2.3",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@react-three/fiber": "^8.17.10",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "contentful": "^11.12.10",
    "lucide-react": "^0.363.0",
    "moment-timezone": "^0.5.45",
    "motion": "^10.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.2.2",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.2.69",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.169.0",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "typescript": "^5.4.3"
  },
  "packageManager": "pnpm@8.15.5",
  "pnpm": {
    "overrides": {
      "browserslist": "4.28.7",
      "picomatch@2": "2.3.2"
    }
  }
}
